@startuml
abstract class BaseController {
    #subSectionService: SubSectionService
    #subSectionRepository: SubSectionRepository
    #objectMapper: ObjectMapper

    + abstract updateSection(CardsContent cardsContent, String action, SubSectionKey key): String
    + abstract getSubSection(SubSectionKey key): SubSection
    # abstract getFolderName(): String
}

abstract class StringController {
    + updateSection(CardsContent cardsContent, String action)
}
abstract class MultipleStringController {
    + updateSection(CardsContent cardsContent, String action)
}
LandingPageWords --|> MultipleStringController
LandingPageSection --|> StringController
ContactUsController --|> StringController
StringController --|> BaseController
MultipleStringController --|> BaseController

abstract class CardsIMGsController {
    + updateSection(CardsContent cardsContent, String action)
}

CardsIMGsController --|> BaseController

ClientsSecitonController --|> CardsIMGsController
LandingPageBankLogosController --|> CardsIMGsController
LandingPageCardsController --|> CardsIMGsController
ServicesSectionController --|> CardsIMGsController
AboutUsController --|> CardsIMGsController


Abstract class Card {
    - String imageUrl;
    - ImageHandler image;
    - boolean visible;

}

class RegularCard {
    - String title;
    - String header;
    - String description;
}

class BankCard {
    - String name;
    - String bankLink;
}

class CardsContent {
    List<Card> cards;
}

CardsContent *-- Card
BankCard --|> Card
RegularCard --|> Card


@enduml